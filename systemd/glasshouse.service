[Unit]
Description=Glasshouse Passive TLS Network Observability & Privacy Radar
After=network.target network-online.target systemd-networkd.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/glasshouse
Environment="PATH=/opt/glasshouse/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/glasshouse/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s

# Security / Capabilities for packet sniffing
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
